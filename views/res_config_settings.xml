<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 1. Neutralize legacy Muk settings in General Settings -->
    <record id="view_res_config_settings_appsbar_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.appsbar.hide</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_web_appsbar.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='appbar_image']/../.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_res_config_settings_colors_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.colors.hide</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_web_colors.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='branding_settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Dedicated Top-Level Theme Application Settings Tab -->
    <record id="view_res_config_settings_theme_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ansis.theme</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Theme &amp; Branding" string="Theme &amp; Branding" name="ansis_web_theme">
                    <!-- Typography & UI Density Block -->
                    <block title="Typography &amp; Layout Density" id="ansis_theme_typography_block">
                        <setting id="ansis_theme_font_family_setting"
                                 string="Primary Font Family"
                                 help="Choose the default typography typeface for backend views, menus, and forms.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="theme_font_family" string="Font Family" class="col-lg-4 o_light_label"/>
                                    <field name="theme_font_family" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="ansis_theme_font_size_setting"
                                 string="Base Font Scale"
                                 help="Select overall base font scaling for standard reading text.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="theme_font_size" string="Font Scale" class="col-lg-4 o_light_label"/>
                                    <field name="theme_font_size" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="ansis_theme_ui_density_setting"
                                 string="UI Layout Density"
                                 help="Adjust vertical density across table rows (32px / 40px / 48px) and form sheets.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="theme_ui_density" string="Density" class="col-lg-4 o_light_label"/>
                                    <field name="theme_ui_density" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- Brand Colors & Accents Block -->
                    <block title="Brand Palette &amp; Colors" id="ansis_theme_brand_colors_block">
                        <setting id="ansis_theme_brand_color_setting"
                                 string="Primary Brand Accent"
                                 help="Main accent color for active navigation tabs, action buttons, and focus glow rings.">
                            <div class="content-group">
                                <div class="row mt16 align-items-center">
                                    <label for="theme_brand_color" string="Accent Color" class="col-lg-4 o_light_label"/>
                                    <div class="col-lg-8 d-flex align-items-center gap-2">
                                        <field name="theme_brand_color" widget="color" class="flex-grow-1"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting id="ansis_theme_colors_advanced_setting"
                                 string="Theme Palette Variables"
                                 help="Fine-tune individual UI element colors and menu text.">
                            <div class="w-100 row mt8">
                                <div class="col-lg-6 mb-2">
                                    <label for="theme_color_appsmenu_text" string="Apps Menu Text" class="d-block text-muted small"/>
                                    <field name="theme_color_appsmenu_text" widget="color"/>
                                </div>
                                <div class="col-lg-6 mb-2">
                                    <label for="theme_color_appbar_text" string="Navbar Text" class="d-block text-muted small"/>
                                    <field name="theme_color_appbar_text" widget="color"/>
                                </div>
                                <div class="col-lg-6 mb-2">
                                    <label for="theme_color_appbar_active" string="Active Element" class="d-block text-muted small"/>
                                    <field name="theme_color_appbar_active" widget="color"/>
                                </div>
                                <div class="col-lg-6 mb-2">
                                    <label for="theme_color_appbar_background" string="Canvas Tint" class="d-block text-muted small"/>
                                    <field name="theme_color_appbar_background" widget="color"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_reset_theme_color_assets"
                                        icon="fa-refresh"
                                        type="object"
                                        string="Reset Theme Colors to Default"
                                        class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                    <!-- Company Wallpaper & Assets Block -->
                    <block title="Company Wallpaper &amp; Assets" id="ansis_theme_wallpaper_block">
                        <setting id="ansis_theme_wallpaper_setting"
                                 string="Home Menu Wallpaper"
                                 company_dependent="1"
                                 help="Background wallpaper image displayed in the fullscreen Home Menu dashboard.">
                            <div class="content-group">
                                <field name="theme_background_image" widget="image" class="w-75"/>
                            </div>
                        </setting>
                        <setting id="ansis_theme_favicon_setting"
                                 string="Browser Tab Favicon"
                                 company_dependent="1"
                                 help="Custom icon displayed in browser tabs and bookmark shortcuts.">
                            <div class="content-group">
                                <field name="theme_favicon" widget="image" class="oe_avatar"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- 3. Direct Window Action for Theme Application Settings -->
    <record id="action_ansis_theme_config_settings" model="ir.actions.act_window">
        <field name="name">Theme &amp; Branding Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ansis_web_theme'}</field>
    </record>

</odoo>
