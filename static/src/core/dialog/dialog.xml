<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ansis_web_theme.Dialog" t-inherit="web.Dialog" t-inherit-mode="extension">
        <xpath expr="//div[@t-attf-class='modal-{{props.size}}']" position="attributes">
            <attribute name="t-attf-class">modal-{{ this.data?.size || props.size || 'lg' }}</attribute>
        </xpath>
    </t>

    <t t-name="ansis_web_theme.Dialog.header" t-inherit="web.Dialog.header" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('modal-title')]" position="attributes">
            <attribute name="class" add="flex-shrink-0 w-75" separator=" " />
        </xpath>
        <xpath expr="//button[hasclass('btn-close')]" position="before">
            <button 
                t-if="!fullscreen"
                type="button" 
                class="btn float-end me-1 mk_btn_dialog_size ansis_btn_dialog_size d-inline-flex align-items-center justify-content-center p-0" 
                t-on-click="() => this.onClickDialogSizeToggle()"
                aria-label="Maximize or Restore Dialog"
                title="Maximize or Restore Dialog"
            >
                <i t-attf-class="fa {{ this.data?.size === 'fs' ? 'fa-compress' : 'fa-expand' }}" />
            </button>
        </xpath>
    </t>

</templates>
