<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ansis_web_theme.AppsBar">
        <div class="mk_apps_sidebar_panel ansis_apps_sidebar_panel">
            <div class="mk_apps_sidebar ansis_apps_sidebar">
                <ul class="mk_apps_sidebar_menu ansis_apps_sidebar_menu">
                    <t t-foreach="this.appMenuService.getAppsMenuItems()" t-as="app" t-key="app.id">
                        <li t-attf-class="nav-item {{ app.id === this.appMenuService.getCurrentApp()?.id ? 'active' : '' }}">
                            <a 
                                t-att-href="app.href"
                                t-att-data-menu-id="app.id" 
                                t-att-data-menu-xmlid="app.xmlid" 
                                t-att-data-action-id="app.actionID"
                                t-on-click.prevent="() => this._onAppClick(app)"
                                class="nav-link" 
                                role="menuitem"
                                t-att-title="app.label"
                            >
                                <img 
                                    t-if="app.webIconData" 
                                    class="mk_apps_sidebar_icon ansis_apps_sidebar_icon" 
                                    t-att-src="app.webIconData"
                                    alt="App Icon"
                                />
                                <img  
                                    t-else="" 
                                    class="mk_apps_sidebar_icon ansis_apps_sidebar_icon" 
                                    src="/base/static/description/icon.png"
                                    alt="App Icon"
                                />
                                <span class="mk_apps_sidebar_name ansis_apps_sidebar_name">
                                    <t t-out="app.label"/>
                                </span>
                            </a>
                        </li>
                    </t>
                </ul>
                <div t-if="sidebarImageUrl" class="mk_apps_sidebar_logo ansis_apps_sidebar_logo p-2">
                    <img class="img-fluid mx-auto" t-att-src="sidebarImageUrl" alt="Sidebar Logo"/>
                </div>
            </div>
        </div>
    </t>

</templates>
